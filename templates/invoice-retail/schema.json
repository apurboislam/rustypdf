{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retail invoice",
  "type": "object",
  "required": ["invoice_no", "date", "seller", "customer", "items"],
  "properties": {
    "invoice_no": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "minLength": 1 },
    "seller": { "$ref": "#/$defs/party" },
    "customer": { "$ref": "#/$defs/party" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "qty", "price"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "qty": { "$ref": "#/$defs/amount" },
          "unit": { "type": "string" },
          "price": { "$ref": "#/$defs/amount" },
          "photo": { "type": ["string", "null"] }
        }
      }
    },
    "discount": { "$ref": "#/$defs/amount" },
    "vat_percent": { "$ref": "#/$defs/amount" },
    "payment": { "type": "string" },
    "notes": { "type": "string" },
    "signature": { "type": ["string", "null"] }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "bin": { "type": "string" }
      }
    },
    "amount": {
      "description": "A number, or a string of ASCII or Bangla digits (printed as sent).",
      "anyOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9০-৯][0-9০-৯,]*(\\.[0-9০-৯]+)?$" }
      ]
    }
  }
}
